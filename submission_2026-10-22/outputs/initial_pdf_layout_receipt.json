  "glossary": [
    {
      "term": "1  CAPM return",
      "definition": "Annual arithmetic forecast: risk-free rate + beta x market premium; forecast alpha=0.",
      "lines": 1,
      "font_size": 7.5
    },
    {
      "term": "2  Volatility",
      "definition": "Monthly return standard deviation x sqrt(12); an annual risk estimate, not a loss cap.",
      "lines": 1,
      "font_size": 7.5
    },
    {
      "term": "3  Utility (A)",
      "definition": "E[R] - 0.5 x A x annual variance; a higher A applies a larger penalty to risk.",
      "lines": 1,
      "font_size": 7.5
    },
    {
      "term": "4  CAGR",
      "definition": "The constant annual compound rate over a period; the goal hurdle includes retained coupon cash.",
      "lines": 1,
      "font_size": 7.5
    },
    {
      "term": "5  Drawdown",
      "definition": "Decline in the flow-adjusted growth-sleeve unit value from its previous peak.",
      "lines": 1,
      "font_size": 7.5
    }
